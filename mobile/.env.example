# Base URL of the SUST EEE Portal API, including the /api/v1 prefix.
# Copy this file to .env and point it at a reachable backend.
#
#   Android emulator : http://10.0.2.2:8000/api/v1   (10.0.2.2 = host loopback)
#   iOS simulator    : http://localhost:8000/api/v1
#   Physical device  : http://<your-lan-ip>:8000/api/v1
#   Production       : https://api.sust-eee-portal.example.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
