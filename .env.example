ENVIRONMENT=development
SECRET_KEY=dev_secret_key_change_in_production_sust_eee_256bit
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sust_eee_db
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sust-eee-resources

GEMINI_API_KEY=your_gemini_api_key
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=your_key
VITE_FIREBASE_PROJECT_ID=sust-eee-portal
VITE_FIREBASE_MESSAGING_SENDER_ID=10987654321
VITE_FIREBASE_APP_ID=1:10987654321:web:abcdef
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# --- first-run administrator -------------------------------------------------
# There is no seeded admin account. Set both values before the first start and
# the API creates this account with a forced password change (minimum 12 bytes).
# Remove or blank them afterwards; they are only read when no super_admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_IDENTIFIER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# --- account security --------------------------------------------------------
# Privileged accounts must enrol TOTP before they can use anything else.
MFA_REQUIRED_FOR_SUPER_ADMIN=true
MFA_ISSUER=SUST EEE Portal

# --- password reset email ----------------------------------------------------
# Without SMTP_HOST the reset link is only written to the log in non-production
# environments, and only the "email unavailable" warning is logged in production.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sust.edu
SMTP_USE_TLS=true
