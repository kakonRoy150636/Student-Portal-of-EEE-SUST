ENVIRONMENT=development
SECRET_KEY=dev_secret_key_change_in_production_sust_eee_256bit
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sust_eee_db
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sust-eee-resources

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_DAILY_USER_QUOTA=20
# Micro-USD: 1000000 = USD 1.00 per Asia/Dhaka calendar day.
AI_GLOBAL_DAILY_CAP_MICRO_USD=1000000
# Conservative per-million-token price ceilings; review against provider prices.
AI_INPUT_MICRO_USD_PER_MILLION=1000000
AI_OUTPUT_MICRO_USD_PER_MILLION=5000000
AI_EMBED_MICRO_USD_PER_MILLION=150000
AI_MAX_OUTPUT_TOKENS=768
AI_RRF_LEXICAL_WEIGHT=1.0
AI_RRF_VECTOR_WEIGHT=1.0
AI_RRF_K=60
AI_RETRIEVAL_TOP_K=5
AI_MIN_LEXICAL_COVERAGE=0.6
AI_MIN_VECTOR_SIMILARITY=0.8
# Optional: set a unique secret before enabling GitHub deliveries.
GITHUB_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=your_key
VITE_FIREBASE_PROJECT_ID=sust-eee-portal
VITE_FIREBASE_MESSAGING_SENDER_ID=10987654321
VITE_FIREBASE_APP_ID=1:10987654321:web:abcdef
VITE_FIREBASE_VAPID_KEY=your_vapid_key
